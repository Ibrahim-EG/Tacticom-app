<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Basic server + LAN detection -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Ringing -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+ requires this to be requested at runtime just to show
         a notification at all, including the persistent "server running"
         one and the ring alert. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Staying alive in the background is the whole point of this app:
         it's a foreground service (a permanent visible notification, the
         same pattern music/nav apps use) so Android doesn't kill it when
         the screen is off. "dataSync" is the closest official category to
         "long-running network service"; Android 14+ requires declaring a
         type explicitly or the service is not allowed to start at all. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Lets the app prompt to be exempted from Doze/battery-optimization
         killing, without which Android can still suspend it hours later
         even with a foreground service, on some OEM skins (Samsung/Xiaomi
         especially). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Auto-start the service again after a phone reboot, so this really
         behaves like an always-on house intercom rather than something you
         have to remember to relaunch. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Tacticom"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TacticomService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
